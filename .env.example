VITE_SUPABASE_PROJECT_ID="mbhjganbihamoiqmankv"
VITE_SUPABASE_URL="https://mbhjganbihamoiqmankv.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_SOCIAL_SUPABASE_ANON_KEY"

# Canonical large media server. New uploads MUST go through this API/MinIO path;
# Supabase Storage fallback is deliberately off unless explicitly enabled.
VITE_MEDIA_API_URL="https://api.alsamos.com"
VITE_MEDIA_PUBLIC_BASE_URL="https://media.alsamos.com/media"
VITE_MEDIA_ALLOW_SUPABASE_FALLBACK="false"

# Canonical server AI gateway. It proxies to the internal AI service and exposes
# the Kubernetes-isolated sandbox at /v1/sandbox/run.
VITE_ALSAMOS_AGENT_SERVER_URL="https://api.alsamos.com/ai"

# AI code sandbox used by Supabase Edge Functions (server-only secrets).
# For test deployment, Lovable/Supabase should set these as Edge Function
# secrets, not browser VITE_* variables:
# SANDBOX_API_URL="https://sandbox.alsamos.com"
# SANDBOX_API_KEY="alsamos-dev-sandbox-change-before-production"


# Optional premium map integrations.
# GTFS/transport backend: GET <base>/arrivals?stop=<osm-stop-id>
# response: { "arrivals": [{ "ref": "57", "minutes": 4 }] }
VITE_TRANSIT_RT_URL=""

# Licensed traffic raster tile template, e.g. https://provider/{z}/{x}/{y}.png
# Keep provider attribution/licensing terms when configuring this value.
VITE_TRAFFIC_TILE_URL=""


# Supabase Edge Function secrets (set with supabase secrets set; NOT VITE_ vars).
# Direct GTFS mode:
# TRANSIT_GTFS_STATIC_URL="https://operator.example/gtfs.zip"
# TRANSIT_GTFS_RT_TRIP_UPDATES_URL="https://operator.example/trip-updates.pb"
# TRANSIT_GTFS_RT_VEHICLES_URL="https://operator.example/vehicle-positions.pb"
# TRANSIT_GTFS_HEADERS_JSON='{"x-api-key":"secret"}'
#
# Or normalized provider mode:
# TRANSIT_NORMALIZED_URL="https://your-transit-adapter.example/api"


# First-party Global Search crawler (Supabase Edge Function secret).
# Use a long random value and call web-crawler with x-crawler-secret.
# CRAWLER_SECRET="replace-with-long-random-secret"


# Alsamos Global Search / Gemini Google Search grounding.
# Configure as Supabase Edge Function secrets, never as VITE_* variables.
# ALSAMOS_SEARCH_API_KEY="server-only-google-api-key"
# Optional classic Programmable Search Engine ID (cx):
# ALSAMOS_SEARCH_CX=""
# Optional Gemini model override:
# ALSAMOS_SEARCH_MODEL="gemini-2.5-flash"


# Real wallet provider secrets (Supabase Edge Function secrets / GitHub Actions
# repository secrets; never expose these as VITE_* variables).
# Required for Payme live top-ups after merchant onboarding:
# PAYME_MERCHANT_ID=""
# PAYME_LOGIN=""
# PAYME_KEY=""
# Optional sandbox key and checkout URL:
# PAYME_TEST_KEY=""
# PAYME_CHECKOUT_URL="https://checkout.paycom.uz"
# ALSAMOS_APP_URL="https://www.alsamos.com/payment?topup=return"
